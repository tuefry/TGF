<meta content="FDsFFiNTC0QbfXt5ACVKbxkGEEUgFBJADWNgL2CvX89LCr8-Z2t2Ruxx" name="csrf-token">
<script type="text/javascript" src='/js/holdsport_ex_i2.js?vsn=c681cf00740c6ed532528403bec7f516'></script>


<script>
  (function() {
    document.addEventListener("DOMContentLoaded", function() {
      var current_page, openSignupForm, roleSet;
      roleSet = void 0;
      current_page = 1;
      openSignupForm = function(role, header) {
        var error;
        if (role == null) {
          role = void 0;
        }
        if (header == null) {
          header = false;
        }
        try {
          if (window.HoldsportCalendly) {
            window.HoldsportCalendly.captureSignup();
          }
        } catch (error1) {
          error = error1;
          null;
        }
        // ITD-5555: send the clicked button's fixed id with the sign-up. 'inline_demo' is the
        // attribution fallback when no button was identified. An open without an identified
        // button (e.g. "create account" in the login form after "have account") keeps the
        // id of the button that started this sign-up.
        var signupCtaId = '';
        try {
          var signupContext = window.HoldsportCalendly && window.HoldsportCalendly.signupContext();
          if (signupContext && signupContext.cta_id && signupContext.cta_id !== 'inline_demo') {
            signupCtaId = signupContext.cta_id;
          }
        } catch (error2) {
          null;
        }
        if (signupCtaId) {
          $('#signup_attribution_cta_id').val(signupCtaId);
        }
        roleSet = role;
        current_page = 1;
        $('#user_info').addClass('signup_mode').removeClass('login_mode');
        $('form#new_user').show();
        $('form#new_user #sign_up_section').show();
        $('form#new_user #choose_role_section').hide();
        $('form#new_user #create_club_and_team_section').hide();
        $('form#new_user #create_club_and_team_section2').hide();
        $('form#new_user #demo_booking_section').hide();
        $('#user_role').val(role);
        $('form#new_user .member').hide();
        $('form#new_user #duplicate_profile_section').hide();
        $('#sign_in').hide();
        $('#forgot_password').hide();
        $('#signin_particular_user_section').hide();
        $('#user_mobile').removeAttr('required');
        $('#user_info').modal('show');
        return $('#user_info').on('shown.bs.modal', function(e) {
  
          /* Refresh Parsley to make it aware of the fields that are no longer hidden */
          return $('form.new_user').each(function(index, element) {
            return $(element).parsley()._refreshFields();
          });
        });
      };
      pageData['openSignupForm'] = openSignupForm;
      $('.show_login_modal').click(function() {
        $('#user_info').addClass('login_mode').removeClass('signup_mode');
        $('#sign_in').show();
        $('.return_to_duplicate_profile_wrapper').show();
        return $('form#new_user').hide();
      });
      $('#sign_up_duplicate_profile_with_role').click(function() {
        window.allowDuplicateProfile = true;
        $('form#new_user #duplicate_profile_section').hide();
        return $('form#new_user #create_club_and_team_section2').show();
      });
      return $(function() {
        var originalShowDemoBookingConfirmation, tzName;
        tzName = jstz.determine().name();
        $('#user_time_zone').val(tzName);
        window.allowDuplicateProfile = false;
        $('form#new_user #sign_up_section .frontpage_modal_btn.next').click(function(e) {
          var promise;
          e.preventDefault();
          promise = $('form#new_user').parsley().whenValidate();
          return promise.done(function() {
            var email, firstname, lastname, nameAndEmailUnique;
            if (window.allowDuplicateProfile) {
  
              /* Just ignore it */
              nameAndEmailUnique = true;
            } else {
              firstname = $('input#user_firstname').val();
              lastname = $('input#user_lastname').val();
              email = $('input#user_email').val();
              nameAndEmailUnique = true;
              $.ajax({
                url: '/existing_user',
                dataType: "json",
                data: {
                  email: email,
                  firstname: firstname,
                  lastname: lastname
                },
                async: false
              }).done(function(data) {
                return nameAndEmailUnique = false;
              }).fail(function(data) {
                return nameAndEmailUnique = true;
              });
            }
            if (!nameAndEmailUnique) {
  
              /* Prompt the user */
              $('form#new_user #sign_up_section').hide();
              return $('form#new_user #duplicate_profile_section').show();
            } else {
              $('form#new_user #sign_up_section').hide();
              if (roleSet === 1) {
                return $('.member_role').click();
              } else if (roleSet === 2) {
                return $('.coach_role').click();
              } else if (roleSet === 3) {
                return $('.admin_role').click();
              } else if (roleSet === 4) {
                return $('.parent_role').click();
              } else {
                return $('form#new_user #choose_role_section').show();
              }
            }
          });
        });
        $('.member_role').click(function(e) {
          var promise;
          promise = $('form#new_user').parsley().whenValidate();
          return promise.done(function(p) {
            $('form#new_user #create_club_and_team_section2').hide();
            $('form#new_user input[name="user[role]"]').val("1");
            return $('form#new_user #choose_role_section .btn_create').click();
          });
        });
        $('.parent_role').click(function(e) {
          var promise;
          promise = $('form#new_user').parsley().whenValidate();
          return promise.done(function(p) {
            $('form#new_user #create_club_and_team_section2').hide();
            $('form#new_user input[name="user[role]"]').val("4");
            return $('form#new_user #choose_role_section .btn_create').click();
          });
        });
        $('.coach_role').click(function(e) {
          var promise;
          promise = $('form#new_user').parsley().whenValidate();
          return promise.done(function(p) {
            (typeof fbq !== "undefined" && fbq !== null) && fbq('trackCustom', 'CoachRolePicked');
            $('form#new_user input[name="user[role]"]').val("2");
            $('form#new_user .admin').hide();
            $('form#new_user .coach').show();
            $('form#new_user .coach_headline').show();
            $('form#new_user #choose_role_section').hide();
            $('form#new_user #create_club_and_team_section2').hide();
            $('form#new_user #create_club_and_team_section').show();
            $('form#new_user #create_club_and_team_section .frontpage_modal_btn').attr('id', 'create_coach_btn');
            return $('form#new_user #user_team_name').attr('placeholder', "Indtast dit holds navn");
          });
        });
        $('.admin_role').click(function(e) {
          var promise;
          promise = $('form#new_user').parsley().whenValidate();
          promise.done(function(p) {
            var consent, ref;
            (typeof fbq !== "undefined" && fbq !== null) && fbq('trackCustom', 'AdminRolePicked');
            $('form#new_user input[name="user[role]"]').val("3");
            $('form#new_user .coach_headline').hide();
            $('form#new_user .coach').show();
            $('form#new_user .admin').show();
            $('form#new_user #choose_role_section').hide();
            $('form#new_user #create_club_and_team_section2').hide();
            $('form#new_user #create_club_and_team_section').show();
            $('form#new_user #create_club_and_team_section .frontpage_modal_btn').attr('id', 'create_admin_btn');
            $('form#new_user #user_team_name').attr('placeholder', "Indtast navnet på klubbens første hold");
            consent = $('form#new_user .automated_call_consent');
            if (consent.length && !consent.data('impression-tracked')) {
              if ((ref = window.ahoy) != null) {
                ref.track('Call consent impression', {
                  market: consent.data('market'),
                  source: consent.data('source')
                });
              }
              return consent.data('impression-tracked', true);
            }
          });
          if ($('#create_club_and_team_section').hasClass('hidden')) {
            return $('#admin_mobile').removeAttr('required');
          } else {
            return $('#admin_mobile').attr('required', 'required');
          }
        });
        $('form#new_user #choose_role_section .btn_previous').click(function() {
          $('form#new_user #sign_up_section').show();
          return $('form#new_user #choose_role_section').hide();
        });
        $('form#new_user #create_club_and_team_section .btn_previous').click(function() {
          $('form#new_user #choose_role_section').show();
          return $('form#new_user #create_club_and_team_section').hide();
        });
  
        /* Make parsley work with the Rails error messages */
        window.ParsleyConfig = window.ParsleyConfig || {};
        window.ParsleyConfig.i18n = window.ParsleyConfig.i18n || {};
  
        /* Define then the messages */
        window.ParsleyConfig.i18n.da = jQuery.extend(window.ParsleyConfig.i18n.da || {}, {
          required: "skal udfyldes",
          type: {
            email: "Indtast en gyldig emailadresse"
          }
        });
  
        /* If file is loaded after Parsley main file, auto-load locale */
        if ('undefined' !== typeof window.ParsleyValidator) {
          window.Parsley.addCatalog('da', window.ParsleyConfig.i18n.da, true);
        }
  
        /* Firstname and lastname validation is handled by the required attribute */
  
        /* Mobile */
        $('#user_mobile').attr('data-parsley-pattern', '/^(\\D*\\d){6,20}\\D*$/');
        $('#user_mobile').attr('data-parsley-error-message', "Ikke gyldig");
        $('#admin_mobile').attr('data-parsley-pattern', '/^(\\D*\\d){6,20}\\D*$/');
        $('#admin_mobile').attr('data-parsley-error-message', "Ikke gyldig");
        $('#user_mobile').on('input', function() {
          return $('#admin_mobile').val($('#user_mobile').val());
        });
        $('#admin_mobile').on('input', function() {
          return $('#user_mobile').val($('#admin_mobile').val());
        });
        $('#user_automated_call_consent_accepted').on('change', function() {
          var consent, ref;
          if ($(this).is(':checked')) {
            consent = $(this).closest('.automated_call_consent');
            return (ref = window.ahoy) != null ? ref.track('Call consent tick', {
              market: consent.data('market'),
              source: consent.data('source')
            }) : void 0;
          }
        });
  
        /* Username */
        $('#user_username').attr('data-parsley-remote', '');
        $('#user_username').attr('data-parsley-remote-validator', 'user-uniqueness');
        $('#user_username').attr('data-parsley-error-message', "er allerede brugt");
        $('#user_username').attr('data-parsley-maxlength', 24);
  
        /* Password */
        $('#user_password').attr('data-parsley-minlength', 8);
        $('#user_password').attr('data-parsley-error-message', "er for kort (mindst 8 tegn)");
  
        /* Terms */
        $('#user_terms_accepted').attr('required', '');
        $('#user_terms_accepted').attr('data-parsley-error-message', "skal accepteres");
  
        /* $('#user_data_terms_accepted').attr('required', '') */
  
        /* Consent */
        $('#user_gdpr_consent_accepted').attr('required', '');
        $('#user_gdpr_consent_accepted').attr('data-parsley-error-message', "skal accepteres");
  
        /* Club name */
        $('#user_club_name').attr('data-parsley-remote', '');
        $('#user_club_name').attr('data-parsley-remote-validator', 'club-uniqueness');
        $('#user_club_name').attr('data-parsley-error-message', "er allerede brugt");
  
        /* Clubs business conditions are required to be accepted if creating a club. */
        $('#user_business_conditions_accepted').attr('required', '');
        $('#user_business_conditions_accepted').attr('data-parsley-error-message', "skal accepteres");
        $('#user_data_processing_agreement_accepted').attr('required', '');
        $('#user_data_processing_agreement_accepted').attr('data-parsley-error-message', "skal accepteres");
  
        /* Used when validating the uniqueness of the user's username */
        window.Parsley.addAsyncValidator('user-uniqueness', (function(xhr) {
          return xhr.responseJSON.length === 0;
        }), '/validate?klass=user&attribute=username&value={value}&kind=uniqueness&original_value=');
  
        /* Used when validating the uniqueness of the club's name */
        window.Parsley.addAsyncValidator('club-uniqueness', (function(xhr) {
          return xhr.responseJSON.length === 0;
        }), '/validate?klass=club&attribute=name&value={value}&kind=uniqueness&original_value=');
  
        /* Bootstrap 3 compatible, with validation before entering stuff in the fields and an key strokes */
        $('form.new_user').parsley({
          validationThreshold: 0,
          trigger: 'keyup change',
          successClass: 'has-success',
          errorClass: 'has-error',
          classHandler: function(el) {
            return el.$element.closest(".form-group");
          },
          errorsContainer: function(el) {
            return el.$element.closest(".form-group");
          },
          errorsWrapper: '<span></span>',
          errorTemplate: '<span class=\'help-block\'></span>',
          excluded: "input[type=button], input[type=submit], input[type=reset], input[type=hidden], [disabled], :hidden"
        });
        $('form#new_user #duplicate_profile_section .btn_previous').click(function() {
          $('form#new_user #sign_up_section').show();
          $('form#new_user #duplicate_profile_section').hide();
          return window.allowDuplicateProfile = false;
        });
        $('form#new_user #create_club_and_team_section2 .btn_previous').click(function() {
          $('form#new_user #sign_up_section').hide();
          $('form#new_user #duplicate_profile_section').show();
          return $('form#new_user #create_club_and_team_section2').hide();
        });
        $('.have_account_link').click(function() {
          $('#user_info').addClass('login_mode').removeClass('signup_mode');
          $('form#new_user').hide();
          return $('#sign_in').show();
        });
  
        /* Preview mode: show demo booking section directly if URL has ?preview_signup_demo_booking=1 */
        if (window.location.search.indexOf('preview_signup_demo_booking') > -1) {
          $('#user_info').addClass('signup_mode').removeClass('login_mode');
          $('#user_info').modal('show');
          $('form#new_user #sign_up_section').hide();
          $('form#new_user #demo_booking_section').show();
          window.demoBookingRedirectUrl = '/';
          loadDemoSlots && loadDemoSlots(4);
        }
  
        /* Demo booking: skip button handler */
        $('.skip_demo_booking').click(function(e) {
          e.preventDefault();
          if (window.demoBookingRedirectUrl) {
            return window.location.href = window.demoBookingRedirectUrl;
          }
        });
  
        /* Demo booking: confirmation close button handler */
        $('.close_demo_booking').click(function(e) {
          e.preventDefault();
          if (window.demoBookingRedirectUrl) {
            return window.location.href = window.demoBookingRedirectUrl;
          } else {
            return $('#user_info').modal('hide');
          }
        });
  
        /* Demo booking: the club already exists, so closing the modal (X, Esc, backdrop) */
  
        /* must still land on the dashboard, which counts the signup conversion. */
        window.goToCreatedClub = function() {
          var url;
          url = window.clubCreatedRedirectUrl;
          if (!url) {
            return;
          }
          window.clubCreatedRedirectUrl = null;
          return window.location.href = url;
        };
        $('#user_info').on('hidden.bs.modal', function() {
          return window.goToCreatedClub();
        });
  
        /* Demo booking: override form submit for admin role on demo-booking domains */
        $('form#new_user').on('submit', function(e) {
          var form, originalText, role, showDemoBooking, submitBtn;
          form = $(this);
          role = form.find('input[name="user[role]"]').val();
          showDemoBooking = form.data('show-demo-booking');
  
          /* Only use AJAX for admin signup on domains that support demo booking */
          if (role === "3" && showDemoBooking) {
            e.preventDefault();
  
            /* Show loading state on button */
            submitBtn = form.find('#create_admin_btn');
            originalText = submitBtn.text();
            submitBtn.prop('disabled', true).text('Indlæser...');
            return $.ajax({
              url: form.attr('action'),
              method: 'POST',
              data: form.serialize(),
              dataType: 'json',
              success: function(response) {
                if (response.success && response.show_demo_booking) {
  
                  /* Store redirect URL for after demo booking */
                  window.demoBookingRedirectUrl = response.redirect_url;
                  window.clubCreatedRedirectUrl = response.redirect_url;
  
                  /* Closed while the signup request was running: no hidden event will follow */
                  if (!$('#user_info').is(':visible')) {
                    window.goToCreatedClub();
                    return;
                  }
  
                  /* Hide club creation section, show demo booking */
                  $('form#new_user #create_club_and_team_section').hide();
                  $('form#new_user #demo_booking_section').show();
  
                  /* Load available time slots */
                  return loadDemoSlots && loadDemoSlots(4);
                } else {
  
                  /* Redirect to dashboard (no demo booking) */
                  return window.location.href = response.redirect_url;
                }
              },
              error: function(xhr) {
                var errorMsg, ref, response;
                submitBtn.prop('disabled', false).text(originalText);
                try {
                  response = JSON.parse(xhr.responseText);
                  errorMsg = ((ref = response.errors) != null ? ref.join(', ') : void 0) || '<span class="translation_missing" title="translation missing: da.errors.messages.something_went_wrong">Something Went Wrong</span>';
                  return alert(errorMsg);
                } catch (error1) {
                  return alert('<span class="translation_missing" title="translation missing: da.errors.messages.something_went_wrong">Something Went Wrong</span>');
                }
              }
            });
          }
  
          /* For all other roles: let the form submit normally */
        });
  
        /* Demo booking: redirect after booking completion */
        originalShowDemoBookingConfirmation = window.showDemoBookingConfirmation;
        return window.showDemoBookingConfirmation = function(startTime) {
          return originalShowDemoBookingConfirmation && originalShowDemoBookingConfirmation(startTime);
  
          /* Show confirmation but with skip button that redirects */
  
          /* The skip_demo_booking click handler will handle the redirect */
        };
      });
    });
  
  }).call(this);
</script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Detect browser timezone
    var timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    var cityName = timezone.split('/').pop();
  
    // Find and set the select field
    var select = document.querySelector('#user_club_time_zone');
    if (select) {
      // Find the option that ends with the city name
      var option = Array.from(select.options).find(function(opt) {
        return opt.text.endsWith(cityName);
      });
  
      if (option) {
        select.value = option.value;
      }
    }
  });
</script>


