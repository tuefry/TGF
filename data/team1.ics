<script>
  window.holdsportCalendlyContext = { page_type: "frontpage" };
  document.addEventListener("DOMContentLoaded", function(event) {
    var link = document.createElement('link');
    link.href = "https://assets.calendly.com/assets/external/widget.css";
    link.rel = 'stylesheet';
    link.type = 'text/css';
    document.head.appendChild(link);
    $.ajax({
        url: "https://assets.calendly.com/assets/external/widget.js",
        dataType: "script",
        cache: true,
        success: function() { if (window.HoldsportCalendly) window.HoldsportCalendly.install(window.Calendly); }
    });
  });
</script>
<script>
  // Popup/iframe: a demo booked through Calendly (conversion in shared/v3/_demo_booking_tracking)
  window.addEventListener("message", function(e) {
    if (e && e.origin === "https://calendly.com" && e.data && e.data.event === "calendly.event_scheduled" && window.hsTrackDemoBooked) {
      window.hsTrackDemoBooked(e.data.payload && e.data.payload.invitee && e.data.payload.invitee.uri);
    }
  });
</script>

<link crossorigin='' href='https://cdn.jsdelivr.net' rel='preconnect'>
<title>
Holdsport: Det foretrukne medlemssystem til din forening

</title>
<meta content='text/html; charset=utf-8' http-equiv='Content-Type'>
<meta content='IE=edge' http-equiv='X-UA-Compatible'>
<meta content='width=device-width, initial-scale=1.0' name='viewport'>
<meta content='yes' name='apple-mobile-web-app-capable'>
<meta content='133545200047566' property='fb:app_id'>
<meta content='app-id=585251235' name='apple-itunes-app'>
<meta content='https://www.holdsport.dk/assets/frontpage/meta_images/more_time_for_sports_da-99ee604830319cd6fd8823361d9550ac4a75f47558d8361c2070cd309e7f073b.jpg' name='thumbnail'>
<meta name="csrf-param" content="authenticity_token" />
<meta name="csrf-token" content="aXJimSM0aGviof_n--tiwZcWm0R42MWXzw_-V7RK6TqJpRishUPWsAg75IA4LKTJgsCSRF_GH1Knlfcb1UOovQ" />
<meta content='Få et medlemssystem, der samler holdkommunikation, medlemsoverblik, kontingentopkrævning mm. i et og samme system.
' name='description'>
<script type='application/ld+json'>
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Hvorfor vælge et cloud-based medlemssystem?","acceptedAnswer":{"@type":"Answer","text":"Et cloud-baseret medlemssystem kræver ingen installation, bliver automatisk opdateret og kan bruges overalt – på computer og mobil. <ul> <li>Ingen installation</li> <li>Altid opdateret</li> <li>Adgang overalt</li> <li>Flere kan arbejde samtidig</li> </ul>"}},{"@type":"Question","name":"Hvordan er sikkerheden omkring vores data?","acceptedAnswer":{"@type":"Answer","text":"Holdsport er bygget til foreninger og klubber med klare adgangsregler: <ul> <li>Personlige logins</li> <li>Roller og rettigheder</li> <li>Krypteret forbindelse (SSL/HTTPS)</li> <li>Eksport af data</li> </ul> Se overblik over hvordan vi håndterer dine data: <a href=\"/users/privacy_policies\">Privatlivspolitik</a>."}},{"@type":"Question","name":"Hvad er det bedste medlemssystem?","acceptedAnswer":{"@type":"Answer","text":"Det \"bedste\" medlemssystem afhænger af jeres behov. Gode kriterier er: <ul> <li>Medlemsadministration og overblik</li> <li>Kalender med til-/afmeldinger</li> <li>Kommunikation til hold og grupper</li> <li>Kontingent og betalingsoverblik</li> </ul> Holdsport passer især godt, hvis I vil samle klubadministration og holdorganisering ét sted."}},{"@type":"Question","name":"Hvad koster Holdsport?","acceptedAnswer":{"@type":"Answer","text":"I kan starte gratis og senere udvide efter behov – afhængigt af medlemstal og funktionsomfang. Typisk findes der: <ul> <li>En gratis basisversion til at organisere foreningen og holdene</li> <li>PRO, hvis I ønsker den fulde pakke med udvidede funktioner</li> </ul> For aktuelle priser kan du besøge vores <a href=\"/public_pages/643\">prisoversigt</a>."}},{"@type":"Question","name":"Kan vi prøve Holdsport gratis?","acceptedAnswer":{"@type":"Answer","text":"Ja – I kan komme i gang gratis og sætte klubben op trin for trin: <ul> <li>Opret klubben</li> <li>Opret hold og roller</li> <li>Importér medlemmer (CSV/Excel)</li> <li>Aktiver kalender og kommunikation</li> </ul> Hvis I vil, kan I også booke en demo/intro, så I kommer hurtigt i mål."}},{"@type":"Question","name":"Hvilke fordele får vi med Holdsport?","acceptedAnswer":{"@type":"Answer","text":"Holdsport samler de vigtigste opgaver i én løsning og reducerer spørgsmål og administration: <ul> <li>Medlemsadministration samlet ét sted</li> <li>Kalender, tilmeldinger og kontingent</li> <li>Beskeder, nyheder og grupper</li> <li>Klare roller og ansvar</li> </ul> Resultat: mindre administration, bedre overblik og mere tid til sporten."}},{"@type":"Question","name":"Har I et billetsystem til arrangementer og events?","acceptedAnswer":{"@type":"Answer","text":"Ja. Med Holdsport kan I sælge billetter til kampe, stævner og klubbens arrangementer og få overblik ét sted. <ul> <li>Billetsalg til events</li> <li>Nem opsætning</li> <li>Overblik over deltagere</li> <li>Mindre manuelt arbejde</li> </ul> I slipper for manuelle lister og kan samle tilmeldinger og billetter i samme system."}},{"@type":"Question","name":"Kan man bruge MobilePay i foreningen?","acceptedAnswer":{"@type":"Answer","text":"Ja. Holdsport gør det nemt at tage imod betalinger via MobilePay – fx til kontingent, aktiviteter og events. <ul> <li>MobilePay-betaling</li> <li>Nemmere for medlemmer</li> <li>Hurtigere opkrævning</li> <li>Bedre betalings-overblik</li> </ul> Det reducerer administration og gør betalingen mere enkel for både forening og medlemmer."}},{"@type":"Question","name":"Hvor hurtigt kan vi komme i gang med Holdsport?","acceptedAnswer":{"@type":"Answer","text":"De fleste klubber er i gang på få timer og kan oprette medlemmer, hold og aktiviteter samme dag."}},{"@type":"Question","name":"Kræver det teknisk erfaring at starte op?","acceptedAnswer":{"@type":"Answer","text":"Nej, opstarten er enkel og intuitiv, så alle i klubben kan være med – også uden teknisk baggrund."}},{"@type":"Question","name":"Hvordan kontakter vi support?","acceptedAnswer":{"@type":"Answer","text":"I kan få hjælp på flere måder, alt efter hvad I har brug for: <ul> <li><a href=\"/public_pages/12\">Hjælpecenter/Guides</a></li> <li><a href=\"/public_pages/80\">Kontaktformular eller e-mail</a></li> <li><a href=\"#\">Demo/online møde ved behov</a></li> </ul>"}}]}
</script>
